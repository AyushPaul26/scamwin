# Copy selected values into ignored .env.local or provider environment settings.
# Never paste live secrets into Markdown, chat, Git, or NEXT_PUBLIC_ variables.
# WEB: Vercel (Node 24)
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
DATABASE_URL=
# Selected hackathon backend; investigations run online with Next.js after().
SCAMWIN_INVESTIGATION_BACKEND=vercel
# Publisher lives in a separate Vercel project; only its URL and dispatch token belong here.
SCAMWIN_PUBLICATION_BACKEND=vercel
SCAMWIN_PUBLISHER_BASE_URL=
# Dedicated random secret with at least 32 characters; match the isolated publisher.
SCAMWIN_PUBLISHER_DISPATCH_SECRET=
# Secret used by the authenticated daily Vercel cleanup route.
CRON_SECRET=
# Optional legacy Trigger investigation backend only.
TRIGGER_SECRET_KEY=
SCAMWIN_PUBLISHER_TRIGGER_SECRET_KEY=
SCAMWIN_ADMIN_SUBJECTS=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
SCAMWIN_AI_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
SCAMWIN_REGISTRY_CHAIN_ID=84532
SCAMWIN_REGISTRY_ADDRESS=
SCAMWIN_REGISTRY_PUBLISHER=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# INVESTIGATION: Vercel Production for the selected Vercel backend.
# A legacy Trigger backend instead needs these in its own project.
TRIGGER_PROJECT_REF=
BROWSERLESS_TOKEN=
BROWSERLESS_BASE_URL=https://production-sfo.browserless.io
# Leave gates off until the documented provider capability checks pass.
SCAMWIN_APPROVED_ORIGINS=
SCAMWIN_BROWSER_CAPABILITY_VERIFIED=false
# Embedded watch-only viewer uses the same Browserless session and token.
SCAMWIN_LIVE_VIEW_ENABLED=false
# Dedicated random 32-byte key (64 hex characters), main app only. Never NEXT_PUBLIC_.
SCAMWIN_LIVE_VIEW_ENCRYPTION_KEY=
SCAMWIN_ORIGIN_PROBE_ENABLED=false
# Main Vercel Production Config only; enable after reviewed-source acceptance and an authorized release.
# No new keys or Browserless approved origins are required. See docs/scamwin-official-source-operations.md.
SCAMWIN_OFFICIAL_VERIFICATION_ENABLED=false
# Optional reviewed-alternative projection; original official-source checks keep their own gate.
SCAMWIN_ALTERNATIVES_ENABLED=false
# Optional curated identity references; never supplied by the browser/model.
SCAMWIN_OFFICIAL_SOURCES_JSON=[]
SCAMWIN_INDICATOR_HMAC_SECRET=

# Publisher signing uses a SEPARATE environment/project.
# See scamwin.publisher.env.example. Never copy its signing key here.

# Connected apps — separate empty Neon project/database; never reuse DATABASE_URL.
# All flags stay false until separately authorized setup and real-account acceptance.
SCAMWIN_CONNECTORS_ENABLED=false
SCAMWIN_CONNECTOR_RUNTIME_ENABLED=false
SCAMWIN_CONNECTOR_AUTOMATION_ENABLED=false
SCAMWIN_CONNECTOR_DATABASE_URL=
SCAMWIN_CONNECTOR_ENCRYPTION_KEY=
SCAMWIN_CONNECTOR_IDENTIFIER_KEY=
SCAMWIN_CONNECTOR_ENCRYPTION_KEY_VERSION=k1
# Optional advanced rotation: JSON object of previous key-version -> 64-hex secret.
SCAMWIN_CONNECTOR_PREVIOUS_ENCRYPTION_KEYS=
SCAMWIN_CONNECTOR_DISPATCH_SECRET=
SCAMWIN_CONNECTOR_GMAIL_ENABLED=false
SCAMWIN_GOOGLE_CLIENT_ID=
SCAMWIN_GOOGLE_CLIENT_SECRET=
SCAMWIN_GOOGLE_REDIRECT_URI=https://scamwin.vercel.app/api/scamwin/connections/gmail/callback
SCAMWIN_GMAIL_PUBLIC_ELIGIBLE=false
SCAMWIN_GMAIL_TEST_USER_PILOT=false
SCAMWIN_GMAIL_PILOT_SUBJECTS=[]
SCAMWIN_CONNECTOR_OUTLOOK_ENABLED=false
SCAMWIN_MICROSOFT_CLIENT_ID=
SCAMWIN_MICROSOFT_CLIENT_SECRET=
SCAMWIN_MICROSOFT_REDIRECT_URI=https://scamwin.vercel.app/api/scamwin/connections/outlook/callback
SCAMWIN_CONNECTOR_TELEGRAM_ENABLED=false
# Telegram OIDC Login credentials are separate from the bot credentials below.
SCAMWIN_TELEGRAM_CLIENT_ID=
SCAMWIN_TELEGRAM_CLIENT_SECRET=
SCAMWIN_TELEGRAM_BOT_USERNAME=
SCAMWIN_TELEGRAM_BOT_TOKEN=
SCAMWIN_TELEGRAM_WEBHOOK_SECRET=
SCAMWIN_CONNECTOR_SLACK_ENABLED=false
SCAMWIN_SLACK_CLIENT_ID=
SCAMWIN_SLACK_CLIENT_SECRET=
SCAMWIN_SLACK_APP_ID=
SCAMWIN_SLACK_SIGNING_SECRET=
SCAMWIN_SLACK_FILES_ENABLED=false
SCAMWIN_SLACK_COVERAGE_PILOT_ACCEPTED=false
SCAMWIN_CONNECTOR_TEAMS_ENABLED=false
SCAMWIN_TEAMS_CLIENT_ID=
SCAMWIN_TEAMS_CLIENT_SECRET=
SCAMWIN_TEAMS_AUTOMATION_PILOT_ACCEPTED=false
SCAMWIN_CONNECTOR_DISCORD_ENABLED=false
SCAMWIN_DISCORD_CLIENT_ID=
SCAMWIN_DISCORD_CLIENT_SECRET=
SCAMWIN_DISCORD_PUBLIC_KEY=
# Drive uses a dedicated Google project/client and server-side Open with.
SCAMWIN_CONNECTOR_DRIVE_ENABLED=false
SCAMWIN_DRIVE_CLIENT_ID=
SCAMWIN_DRIVE_CLIENT_SECRET=
SCAMWIN_DRIVE_INSTALLATION_ACCEPTED=false
SCAMWIN_DRIVE_AUTOMATION_PILOT_ACCEPTED=false
SCAMWIN_CONNECTOR_EXTENSION_ENABLED=false
SCAMWIN_PRIVATE_PUSH_ENABLED=false
SCAMWIN_WEB_PUSH_PUBLIC_KEY=
SCAMWIN_WEB_PUSH_PRIVATE_KEY=
SCAMWIN_WEB_PUSH_SUBJECT=
