# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Blender/Python authoring caches
__pycache__/
*.blend1

# Auth0 credentials
.env.local

.auth0-mcp-state.json

.auth0-mcp-writes.log

# Local Neon CLI context
.neon
.neon/

# Trigger.dev local worker artifacts
.trigger

# Isolated browser-check build output
/.next-chat-check/
/.next-verify/

# Local Scamwin verification output
/scamwin-*.log
/baseline-tests.log
/dependency-install.log
/dependency-*.log
/premium-audit.json
