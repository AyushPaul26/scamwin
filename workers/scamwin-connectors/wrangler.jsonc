{
  "name": "scamwin-connectors-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "SCAMWIN_CONNECTOR_SCHEDULER_ENABLED": "false",
    "SCAMWIN_CONNECTOR_APP_ORIGIN": "https://scamwin.vercel.app"
  }
}
